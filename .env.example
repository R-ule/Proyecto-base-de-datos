# ── Conexión MongoDB Atlas ──────────────────────────────────────────────────
# URI completa del cluster M0. Incluye usuario, contraseña y opciones.
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos (default: utm_desk)
MONGODB_DB_NAME=utm_desk

# ── superAdmin obligatorio ──────────────────────────────────────────────────
# Correo del superAdmin (se usará como identificador único)
SUPER_ADMIN_EMAIL=lizandro.reyes@utmetropolitana.edu.mx

# Contraseña en texto claro; el script la hashea con bcryptjs en tiempo de ejecución
SUPER_ADMIN_PASSWORD=<contraseña_super_admin>

# ── Usuarios de prueba (seed) ───────────────────────────────────────────────
# Contraseña compartida para los usuarios sintéticos (Karla, Luis, Héctor)
SEED_USER_PASSWORD=<contraseña_usuarios_prueba>

# ── Supabase Storage (Fase 4) ───────────────────────────────────────────────
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key_solo_en_servidor>
SUPABASE_BUCKET=evidencias

# ── Backend ─────────────────────────────────────────────────────────────────
PORT=3000

