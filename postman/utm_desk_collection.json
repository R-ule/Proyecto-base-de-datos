  "item": [
    {
      "name": "1. POST Incidencia - Cómputo y Redes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde con estado 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Retorna folio generado y mensaje de éxito', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('codigo');",
              "    pm.expect(jsonData.codigo).to.match(/^INC-2026-\\d{4}$/);",
              "    pm.collectionVariables.set('codigo_folio', jsonData.codigo);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Falla en switch de laboratorio\",\n  \"descripcion\": \"El switch del rack principal no responde al enlace troncal.\",\n  \"categoria\": \"computo_redes\",\n  \"prioridad\": \"alta\",\n  \"ubicacion\": {\n    \"edificio\": \"Edificio A\",\n    \"aula\": \"Laboratorio 1\"\n  },\n  \"detalle_especifico\": {\n    \"tipo_equipo\": \"Switch\",\n    \"ip\": \"192.168.1.10\",\n    \"vlan\": 10,\n    \"puerto_uplink\": \"Gi0/1\",\n    \"equipos_afectados\": 24\n  },\n  \"tags\": [\"redes\", \"switch\", \"prioritario\"]\n}"
        },
        "url": "{{base_url}}/api/incidencias"
      }
    },
